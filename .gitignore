# Pyre type checker
.pyre/

# .svn
.svn/

# emacs artifacts
*~
*#*

# .DS_Store
.DS_Store

# mpi-sppy runtime artifacts from running examples/tests.  Conservative
# patterns — only obvious per-run output, not anything that could be a
# fixture.  Add more here as new artifact patterns appear.
*_summary_iter*_rank*.txt
None_summary_*.txt
__*___summary_*.txt
_delme*
delete_me*
specific.csv_*
_temp_*.csv

# Example output files (each example regenerates these on every run)
examples/**/ef.txt
examples/**/hub.log
examples/**/xhateval.log
examples/**/solution_*.txt
examples/**/*_full_solution/
examples/**/*_pickles/
examples/**/*_cyl_nonants.npy

# LaTeX build products under doc/slides (the .tex and the built .pdf are
# committed; everything else pdflatex/biber leaves behind is not)
doc/slides/**/*.aux
doc/slides/**/*.bbl
doc/slides/**/*.bcf
doc/slides/**/*.blg
doc/slides/**/*.fdb_latexmk
doc/slides/**/*.fls
doc/slides/**/*.nav
doc/slides/**/*.out
doc/slides/**/*.run.xml
doc/slides/**/*.snm
doc/slides/**/*.synctex.gz
doc/slides/**/*.toc
doc/slides/**/*.vrb

# run_coverage.bash console output
coverage.out
run_coverage.out

# Solutions the example drivers write on every run.  Listed by their exact
# paths where a wildcard would shadow a committed baseline -- e.g.
# examples/test_data/farmer_rd_baseline/farmer_soldir/ is a test fixture, so
# there is deliberately no blanket *_soldir/ rule.
examples/**/*_first_stage.csv
examples/netdes/netdes_build.csv
examples/farmer/farmersol.csv
examples/farmer/farmersol.npy
examples/farmer/farmersol_soldir/
examples/farmer/archive/farmer_plant.csv
examples/farmer/archive/results/

# examples/run_more.py writes <ID>.perf.csv next to itself
examples/*.perf.csv

# What the loose_agnostic AMPL/GAMS writers emit per run (the .mod, .gms,
# .bash and .py alongside them are committed)
examples/loose_agnostic/**/_fromAMPL/
examples/loose_agnostic/**/_fromGAMS/
examples/loose_agnostic/**/*_soldir/
examples/loose_agnostic/**/scen*.mps
examples/loose_agnostic/**/scen*.row
examples/loose_agnostic/**/scen*_nonants.json
examples/loose_agnostic/**/scen*_rho.csv
examples/loose_agnostic/**/farmer_solution_output.csv
examples/loose_agnostic/**/farmer_solution_output.npy
examples/loose_agnostic/**/nonant_output.csv
examples/loose_agnostic/**/ampl_text.txt

# Generated by the agnostic GAMS guest from the committed *_average.gms
mpisppy/agnostic/examples/*_ph_linearized.gms

# Written by tests into the directory they run from.  Named exactly: the
# fixtures beside them (scen0_densenames.mps, mps_module_data/*.lp) are
# committed.
mpisppy/tests/cbc_readback.lp
mpisppy/tests/examples/scen0.mps
